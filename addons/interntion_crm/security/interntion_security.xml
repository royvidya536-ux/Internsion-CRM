<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_interntion" model="ir.module.category">
        <field name="name">Interntion CRM</field>
        <field name="description">Access rights for the Interntion internship placement CRM.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_interntion_user" model="res.groups">
        <field name="name">User: Own Applications</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_interntion_manager" model="res.groups">
        <field name="name">Manager: Full Access</field>
        <field name="implied_ids" eval="[(4, ref('group_interntion_user')), (4, ref('sales_team.group_sale_manager')), (4, ref('base.group_system'))]"/>
    </record>

    <record id="group_placement_counselor" model="res.groups">
        <field name="name">Placement Counselor</field>
        <field name="implied_ids" eval="[(4, ref('group_interntion_user'))]"/>
    </record>
    <record id="group_partnership_account_manager" model="res.groups">
        <field name="name">Partnerships Account Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_interntion_user'))]"/>
    </record>
    <record id="group_interntion_mentor" model="res.groups">
        <field name="name">Mentor</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_operations_admin" model="res.groups">
        <field name="name">Operations Admin</field>
        <field name="implied_ids" eval="[(4, ref('group_interntion_manager'))]"/>
    </record>

    <record id="rule_placement_counselor_students" model="ir.rule">
        <field name="name">Placement counselors see student placements</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('group_placement_counselor'))]"/>
        <field name="domain_force">[('team_id.name', '=', 'Student Placements')]</field>
    </record>
    <record id="rule_partnership_manager_partners" model="ir.rule">
        <field name="name">Account managers see corporate partnerships</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('group_partnership_account_manager'))]"/>
        <field name="domain_force">[('team_id.name', '=', 'Corporate Partnerships')]</field>
    </record>
</odoo>
