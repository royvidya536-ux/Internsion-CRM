<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_interntion" model="ir.module.category">
        <field name="name">Interntion CRM</field>
        <field name="description">Access rights for the Interntion internship placement CRM.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_interntion_user" model="res.groups">
        <field name="name">User: Own Applications</field>
        <field name="category_id" ref="module_category_interntion"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_interntion_manager" model="res.groups">
        <field name="name">Manager: Full Access</field>
        <field name="category_id" ref="module_category_interntion"/>
        <field name="implied_ids" eval="[(4, ref('group_interntion_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
