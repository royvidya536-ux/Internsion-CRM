<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="interntion_dashboard_view_form" model="ir.ui.view">
        <field name="name">interntion.dashboard.form</field>
        <field name="model">interntion.dashboard</field>
        <field name="arch" type="xml">
            <form string="Interntion Overview" create="false" edit="false" delete="false">
                <sheet>
                    <h1 class="mb-4">Interntion CRM — Live Overview</h1>
                    <div class="o_horizontal_separator"/>
                    <div class="row">
                        <div class="col-4">
                            <button type="object" name="action_view_placed" class="oe_stat_button" icon="fa-graduation-cap" style="width:100%">
                                <field name="students_placed" widget="statinfo" string="Students Placed"/>
                            </button>
                        </div>
                        <div class="col-4">
                            <field name="success_rate" widget="percentage" string="Success Rate"/>
                        </div>
                        <div class="col-4">
                            <button type="object" name="action_view_partners" class="oe_stat_button" icon="fa-handshake-o" style="width:100%">
                                <field name="industry_partners" widget="statinfo" string="Industry Partners"/>
                            </button>
                        </div>
                    </div>
                    <group>
                        <group string="Pipeline">
                            <field name="total_applications"/>
                            <button type="object" name="action_view_internships" class="oe_link" string="View Open Internships"/>
                            <field name="open_internships"/>
                        </group>
                        <group string="Team">
                            <field name="active_mentors"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="interntion_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">interntion.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="interntion_dashboard_action_server" model="ir.actions.server">
        <field name="name">Open Interntion Dashboard</field>
        <field name="model_id" ref="model_interntion_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.get_or_create_singleton().get_formview_action()</field>
    </record>
</odoo>
