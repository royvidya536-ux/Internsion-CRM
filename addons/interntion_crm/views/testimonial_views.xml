<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="interntion_testimonial_view_list" model="ir.ui.view">
        <field name="name">interntion.testimonial.list</field>
        <field name="model">interntion.testimonial</field>
        <field name="arch" type="xml">
            <list string="Student Testimonials">
                <field name="sequence" widget="handle"/>
                <field name="student_name"/>
                <field name="course"/>
                <field name="role"/>
                <field name="rating"/>
            </list>
        </field>
    </record>

    <record id="interntion_testimonial_view_form" model="ir.ui.view">
        <field name="name">interntion.testimonial.form</field>
        <field name="model">interntion.testimonial</field>
        <field name="arch" type="xml">
            <form string="Testimonial">
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <group>
                        <field name="student_name"/>
                        <field name="course"/>
                        <field name="role"/>
                        <field name="rating"/>
                        <field name="photo_url"/>
                        <field name="active"/>
                    </group>
                    <field name="quote"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="interntion_testimonial_action" model="ir.actions.act_window">
        <field name="name">Student Testimonials</field>
        <field name="res_model">interntion.testimonial</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
