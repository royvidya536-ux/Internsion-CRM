<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_interntion_root" name="Interntion CRM" sequence="5"/>
    <menuitem id="menu_interntion_pipeline" name="Student Journey" parent="menu_interntion_root" sequence="2"/>
    <menuitem id="menu_interntion_catalogue" name="Catalogue" parent="menu_interntion_root" sequence="5"/>
    <menuitem id="menu_interntion_network" name="Network" parent="menu_interntion_root" sequence="4"/>
    <menuitem id="menu_interntion_content" name="Brand Content" parent="menu_interntion_root" sequence="5"/>

    <record id="view_interntion_industry_list" model="ir.ui.view"><field name="name">interntion.industry.list</field><field name="model">interntion.industry</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="active"/></list></field></record>
    <record id="view_interntion_addon_list" model="ir.ui.view"><field name="name">interntion.addon.service.list</field><field name="model">interntion.addon.service</field><field name="arch" type="xml"><list><field name="sequence"/><field name="name"/><field name="product_id"/><field name="active"/></list></field></record>
    <record id="view_interntion_support_list" model="ir.ui.view"><field name="name">interntion.support.ticket.list</field><field name="model">interntion.support.ticket</field><field name="arch" type="xml"><list decoration-danger="priority == '3'" decoration-success="state in ('resolved', 'closed')"><field name="priority" widget="priority"/><field name="name"/><field name="lead_id"/><field name="reporter_type"/><field name="assigned_user_id"/><field name="state"/></list></field></record>
    <record id="view_interntion_support_form" model="ir.ui.view"><field name="name">interntion.support.ticket.form</field><field name="model">interntion.support.ticket</field><field name="arch" type="xml"><form><header><field name="state" widget="statusbar" statusbar_visible="new,in_progress,resolved,closed"/></header><sheet><group><group><field name="name"/><field name="lead_id"/><field name="reporter_type"/></group><group><field name="priority" widget="priority"/><field name="assigned_user_id"/></group></group><field name="description"/><chatter/></sheet></form></field></record>

        <record id="action_interntion_student_pipeline" model="ir.actions.act_window"><field name="name">Student Placements</field><field name="res_model">crm.lead</field><field name="view_mode">kanban,list,form,graph,pivot,activity</field><field name="domain" eval="[('team_id', '=', ref('crm_team_interntion'))]"/><field name="context" eval="{'default_team_id': ref('crm_team_interntion'), 'default_type': 'opportunity', 'default_interntion_side': 'student'}"/></record>
        <record id="action_interntion_partner_pipeline" model="ir.actions.act_window"><field name="name">Corporate Partnerships</field><field name="res_model">crm.lead</field><field name="view_mode">kanban,list,form,graph,pivot,activity</field><field name="domain" eval="[('team_id', '=', ref('team_corporate_partnerships'))]"/><field name="context" eval="{'default_team_id': ref('team_corporate_partnerships'), 'default_type': 'opportunity', 'default_interntion_side': 'partner'}"/></record>
        <record id="action_interntion_industries" model="ir.actions.act_window"><field name="name">Industries</field><field name="res_model">interntion.industry</field><field name="view_mode">list,form</field></record>
        <record id="action_interntion_addons" model="ir.actions.act_window"><field name="name">Student Add-ons</field><field name="res_model">interntion.addon.service</field><field name="view_mode">list,form</field></record>
        <record id="action_interntion_support" model="ir.actions.act_window"><field name="name">Placement Support</field><field name="res_model">interntion.support.ticket</field><field name="view_mode">list,form</field></record>

    <menuitem id="menu_interntion_student_pipeline" name="Student Placements" parent="menu_interntion_root" action="action_interntion_student_pipeline" sequence="5"/>
    <menuitem id="menu_interntion_partner_pipeline" name="Corporate Partnerships" parent="menu_interntion_root" action="action_interntion_partner_pipeline" sequence="6"/>
    <menuitem id="menu_interntion_industries" name="Industries" parent="menu_interntion_root" action="action_interntion_industries" sequence="80"/>
    <menuitem id="menu_interntion_addons" name="Student Add-ons" parent="menu_interntion_root" action="action_interntion_addons" sequence="81"/>
    <menuitem id="menu_interntion_support" name="Placement Support" parent="menu_interntion_root" action="action_interntion_support" sequence="82"/>

    <record id="view_crm_lead_form_interntion_operations" model="ir.ui.view"><field name="name">crm.lead.form.interntion.operations</field><field name="model">crm.lead</field><field name="inherit_id" ref="crm.crm_lead_view_form"/><field name="arch" type="xml">
        <xpath expr="//notebook" position="inside"><page string="Interntion" name="interntion_operations"><group><group string="Marketplace"><field name="interntion_side"/><field name="university_institution"/><field name="country"/><field name="target_industry_ids" widget="many2many_tags"/><field name="placement_mode"/><field name="addon_service_ids" widget="many2many_tags"/></group><group string="Ownership"><field name="mentor_assigned_user_id"/><field name="account_manager_id"/><field name="partner_company_id"/><field name="company_industry_sector"/><field name="partner_country"/><field name="partnership_interest_type"/><field name="active_cohort_count"/></group></group><group string="SLA and outcome"><field name="lead_source_detail"/><field name="sla_deadline" readonly="1"/><field name="sla_status" readonly="1"/><field name="matched_at"/><field name="onboarding_completed"/><field name="expected_internship_end"/><field name="certificate_issued"/><field name="certificate_issued_date"/><field name="latest_cv_attachment_id"/></group><button name="action_create_addon_quotation" type="object" string="Create Add-on Quotation" class="oe_highlight" invisible="interntion_side != 'student' or not addon_service_ids"/><button name="action_view_support_tickets" type="object" string="Placement Support"/></page></xpath>
    </field></record>
</odoo>
