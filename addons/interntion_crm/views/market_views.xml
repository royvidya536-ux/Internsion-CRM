<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="interntion_market_view_tree" model="ir.ui.view">
        <field name="name">interntion.market.tree</field>
        <field name="model">interntion.market</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="currency_symbol"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="interntion_market_view_form" model="ir.ui.view">
        <field name="name">interntion.market.form</field>
        <field name="model">interntion.market</field>
        <field name="arch" type="xml">
            <form string="Market">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="currency_symbol"/>
                        <field name="is_active"/>
                    </group>
                    <notebook>
                        <page string="Prices">
                            <field name="price_ids">
                                <list editable="bottom">
                                    <field name="product_reference" readonly="1"/>
                                    <field name="internship_id"/>
                                    <field name="project_id"/>
                                    <field name="service_id"/>
                                    <field name="amount"/>
                                    <field name="currency_symbol"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="interntion_market_action" model="ir.actions.act_window">
        <field name="name">Markets</field>
        <field name="res_model">interntion.market</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
