<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend the standard CRM lead form with Interntion-specific fields -->
    <record id="crm_lead_view_form_interntion" model="ir.ui.view">
        <field name="name">crm.lead.form.interntion</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info" role="alert" invisible="x_internship_id">
                    Link this application to an Internship Opportunity to auto-fill sector and employer.
                </div>
            </xpath>
            <field name="expected_revenue" position="after">
                <field name="x_is_paid_internship"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Interntion Placement" name="interntion_placement">
                    <group>
                        <group string="Student">
                            <field name="x_course_stream"/>
                            <field name="x_industry_sector"/>
                            <field name="x_application_source"/>
                        </group>
                        <group string="Placement">
                            <field name="x_internship_id"/>
                            <field name="x_employer_id" readonly="1"/>
                            <field name="x_mentor_id"/>
                        </group>
                    </group>
                    <group string="CV &amp; Preparation">
                        <field name="x_cv_file" filename="x_cv_filename"/>
                        <field name="x_cv_filename" invisible="1"/>
                        <field name="x_cv_reviewed"/>
                        <field name="x_mock_interview_done"/>
                        <field name="x_certificate_issued"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Standalone kanban view for the Interntion placement pipeline -->
    <record id="crm_lead_view_kanban_interntion" model="ir.ui.view">
        <field name="name">crm.lead.kanban.interntion</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" records_draggable="1">
                <field name="stage_id"/>
                <field name="partner_name"/>
                <field name="x_course_stream"/>
                <field name="x_industry_sector"/>
                <field name="x_employer_id"/>
                <field name="x_mentor_id"/>
                <field name="expected_revenue"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="partner_name"/></div>
                            <div t-if="record.x_course_stream.value"><field name="x_course_stream"/></div>
                            <div t-if="record.x_employer_id.value">
                                <i class="fa fa-building"/> <field name="x_employer_id"/>
                            </div>
                            <div t-if="record.x_mentor_id.value">
                                <i class="fa fa-user"/> <field name="x_mentor_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Standalone list view for the Interntion placement pipeline -->
    <record id="crm_lead_view_list_interntion" model="ir.ui.view">
        <field name="name">crm.lead.list.interntion</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <list string="Applications">
                <field name="name"/>
                <field name="partner_name" string="Student"/>
                <field name="x_course_stream"/>
                <field name="x_industry_sector"/>
                <field name="x_employer_id"/>
                <field name="x_mentor_id"/>
                <field name="stage_id"/>
                <field name="x_is_paid_internship"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Dedicated action: Internship Applications pipeline -->
    <record id="crm_lead_action_interntion_pipeline" model="ir.actions.act_window">
        <field name="name">Applications Pipeline</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,graph,pivot,calendar,activity</field>
        <field name="domain">[('type', '=', 'opportunity'), ('team_id.name', '=', 'Interntion - Internship Placements')]</field>
        <field name="context">{'default_type': 'opportunity'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first student application!
            </p>
            <p>
                Track every student from first application to a confirmed paid internship placement.
            </p>
        </field>
    </record>

    <record id="crm_lead_action_interntion_pipeline_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="crm_lead_view_kanban_interntion"/>
        <field name="act_window_id" ref="crm_lead_action_interntion_pipeline"/>
    </record>

    <record id="crm_lead_action_interntion_pipeline_view_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm_lead_view_list_interntion"/>
        <field name="act_window_id" ref="crm_lead_action_interntion_pipeline"/>
    </record>
</odoo>
