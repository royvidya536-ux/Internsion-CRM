<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="interntion_faq_view_list" model="ir.ui.view">
        <field name="name">interntion.faq.list</field>
        <field name="model">interntion.faq</field>
        <field name="arch" type="xml">
            <list string="FAQ">
                <field name="sequence" widget="handle"/>
                <field name="question"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="interntion_faq_view_form" model="ir.ui.view">
        <field name="name">interntion.faq.form</field>
        <field name="model">interntion.faq</field>
        <field name="arch" type="xml">
            <form string="FAQ">
                <sheet>
                    <group>
                        <field name="question"/>
                        <field name="category"/>
                        <field name="active"/>
                    </group>
                    <field name="answer"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="interntion_faq_action" model="ir.actions.act_window">
        <field name="name">FAQ</field>
        <field name="res_model">interntion.faq</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
