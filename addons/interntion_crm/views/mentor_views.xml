<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="interntion_mentor_view_list" model="ir.ui.view">
        <field name="name">interntion.mentor.list</field>
        <field name="model">interntion.mentor</field>
        <field name="arch" type="xml">
            <list string="Mentors">
                <field name="name"/>
                <field name="expertise"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="application_count"/>
            </list>
        </field>
    </record>

    <record id="interntion_mentor_view_form" model="ir.ui.view">
        <field name="name">interntion.mentor.form</field>
        <field name="model">interntion.mentor</field>
        <field name="arch" type="xml">
            <form string="Mentor">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_applications" icon="fa-users">
                            <field name="application_count" widget="statinfo" string="Students"/>
                        </button>
                    </div>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Mentor name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="expertise"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Biography" name="bio">
                            <field name="bio"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="interntion_mentor_action" model="ir.actions.act_window">
        <field name="name">Mentors</field>
        <field name="res_model">interntion.mentor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first mentor!</p>
        </field>
    </record>
</odoo>
