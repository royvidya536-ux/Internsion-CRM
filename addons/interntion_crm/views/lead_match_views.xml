<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="interntion_lead_match_view_tree" model="ir.ui.view">
        <field name="name">interntion.lead.match.tree</field>
        <field name="model">interntion.lead.match</field>
        <field name="arch" type="xml">
            <list>
                <field name="lead_id"/>
                <field name="internship_id"/>
                <field name="project_id"/>
                <field name="service_id"/>
                <field name="score"/>
            </list>
        </field>
    </record>

    <record id="interntion_lead_match_view_form" model="ir.ui.view">
        <field name="name">interntion.lead.match.form</field>
        <field name="model">interntion.lead.match</field>
        <field name="arch" type="xml">
            <form string="Lead Match">
                <sheet>
                    <group>
                        <field name="lead_id"/>
                        <field name="internship_id"/>
                        <field name="project_id"/>
                        <field name="service_id"/>
                        <field name="score"/>
                        <field name="match_details"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="interntion_lead_match_action" model="ir.actions.act_window">
        <field name="name">Lead Matches</field>
        <field name="res_model">interntion.lead.match</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
