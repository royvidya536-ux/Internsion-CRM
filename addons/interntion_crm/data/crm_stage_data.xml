<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_interntion" model="crm.team">
        <field name="name">Interntion - Internship Placements</field>
        <field name="use_opportunities">True</field>
    </record>

    <record id="stage_new_application" model="crm.stage">
        <field name="name">New Application</field>
        <field name="sequence">1</field>
        <field name="team_id" ref="crm_team_interntion"/>
    </record>

    <record id="stage_cv_screening" model="crm.stage">
        <field name="name">CV Screening</field>
        <field name="sequence">2</field>
        <field name="team_id" ref="crm_team_interntion"/>
    </record>

    <record id="stage_matched_employer" model="crm.stage">
        <field name="name">Matched with Employer</field>
        <field name="sequence">3</field>
        <field name="team_id" ref="crm_team_interntion"/>
    </record>

    <record id="stage_interview" model="crm.stage">
        <field name="name">Interview Scheduled</field>
        <field name="sequence">4</field>
        <field name="team_id" ref="crm_team_interntion"/>
    </record>

    <record id="stage_offer_extended" model="crm.stage">
        <field name="name">Offer Extended</field>
        <field name="sequence">5</field>
        <field name="team_id" ref="crm_team_interntion"/>
    </record>

    <record id="stage_placed" model="crm.stage">
        <field name="name">Placed</field>
        <field name="sequence">6</field>
        <field name="is_won">True</field>
        <field name="fold">True</field>
        <field name="team_id" ref="crm_team_interntion"/>
    </record>

    <record id="stage_rejected" model="crm.stage">
        <field name="name">Rejected</field>
        <field name="sequence">7</field>
        <field name="fold">True</field>
        <field name="team_id" ref="crm_team_interntion"/>
    </record>
</odoo>
