<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_interntion_sla_monitor" model="ir.cron"><field name="name">Interntion SLA monitor</field><field name="model_id" ref="crm.model_crm_lead"/><field name="state">code</field><field name="code">model.cron_monitor_slas()</field><field name="interval_number">1</field><field name="interval_type">hours</field><field name="active">True</field></record>

    <record id="mail_template_application_received" model="mail.template"><field name="name">Interntion: Application received</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">We received your Interntion application</field><field name="email_from">info@interntion.co.uk</field><field name="email_to">{{ object.email_from }}</field><field name="body_html" type="html"><![CDATA[<div style="font-family:Arial;color:#1a3160"><h2>Thanks for applying to Interntion</h2><p>Hi {{ object.partner_name or 'there' }},</p><p>We have received your application and our placement team will review your profile.</p><p>We aim to match students within 7 days.</p></div>]]></field></record>
    <record id="mail_template_partner_acknowledgement" model="mail.template"><field name="name">Interntion: Partner enquiry acknowledgement</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Your Interntion partnership enquiry</field><field name="email_from">partnerships@interntion.co.uk</field><field name="email_to">{{ object.email_from }}</field><field name="body_html" type="html"><![CDATA[<div style="font-family:Arial;color:#1a3160"><h2>Thanks for contacting Interntion</h2><p>We have received your partnership enquiry. A member of our partnerships team will respond within one business day.</p></div>]]></field></record>
    <record id="mail_template_completion_certificate" model="mail.template"><field name="name">Interntion: Placement completion</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Congratulations on completing your Interntion placement</field><field name="email_from">support@interntion.co.uk</field><field name="email_to">{{ object.email_from }}</field><field name="body_html" type="html"><![CDATA[<div style="font-family:Arial;color:#1a3160"><h2>Congratulations</h2><p>Your Interntion placement is complete. Your industry-recognised completion certificate will be issued by our operations team.</p></div>]]></field></record>
</odoo>
