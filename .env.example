# Set unique, randomly generated values before starting the stack.
DB_USER=odoo
DB_PASSWORD=replace-with-a-unique-random-secret
ODOO_ADMIN_PASSWD=replace-with-a-different-unique-random-secret

# Odoo web ports
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072

# Optional pgAdmin (docker compose --profile tools up)
PGADMIN_EMAIL=admin@interntion.co.uk
PGADMIN_PASSWORD=replace-with-another-unique-random-secret
PGADMIN_PORT=5050
